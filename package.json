{
  "name": "umveil",
  "version": "0.1.0",
  "description": "Two-window live-event display controller for Windows",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "dist": "npm run build && electron-builder",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "keywords": ["electron", "live-event", "display-controller"],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@playwright/test": "^1.47.0",
    "@types/node": "^22.5.5",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/yauzl": "^2.10.3",
    "@types/yazl": "^2.4.5",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^32.1.0",
    "electron-builder": "^25.0.5",
    "electron-vite": "^2.3.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.6",
    "vitest": "^2.1.1"
  },
  "dependencies": {
    "koffi": "^2.8.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "uuid": "^10.0.0",
    "yauzl": "^3.1.3",
    "yazl": "^2.5.1",
    "zod": "^3.23.8"
  },
  "build": {
    "appId": "com.umveil.app",
    "productName": "umveil",
    "win": {
      "target": [
        { "target": "portable", "arch": ["x64"] },
        { "target": "nsis", "arch": ["x64"] }
      ],
      "icon": "resources/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "fileAssociations": [
      { "ext": "umveil", "name": "umveil Scene", "description": "umveil scene file" }
    ],
    "portable": {
      "artifactName": "umveil-${version}-portable.exe"
    },
    "files": ["out/**/*"],
    "extraResources": []
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
